 "loudness.verdict": {
  "key": "loudness.verdict",
  "value": "NO-GO",
  "unit": "verdict of the check frozen before the 24 Oct rides",
  "n": null,
  "detail": {
   "justification": "LST-BTH is louder than BTH-MLE in 10/11 placement-ok trips (mean within-trip difference +0.54 dB, range -0.13 to +1.21; one-sided sign test p=0.006). The difference is below 1 dB, i.e. inside the Voice Memos limiter compression (~1-3 dB) and the run-to-run sd of a section (0.4-0.8 dB). Not robust across variants: LAeq, nospeech_LAeq, core_LAeq, LAeq_1s_mean, LAeq_limiter_ub do not agree in every trip. Absolute levels are uncalibrated dBFS(A), so nothing here can be compared with TfL's dB figures or with the 92.8 dB figure reported by Brixton Buzz.",
   "rule": "GO needs LST-BTH louder on every trip, a mean of at least 1 dB and every level variant agreeing; WEAK if every trip is positive but the rest fails; NO-GO if any trip goes the other way",
   "reversed_trips": "R10_WB_MLE-LST (-0.13 dB)"
  },
  "source": "outputs/gonogo/loudness.json"
