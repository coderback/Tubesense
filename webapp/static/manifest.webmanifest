{
  "name": "Tubesense",
  "short_name": "Tubesense",
  "description": "GPS-free positioning and a checked evidence pack from ordinary Tube rides. Hackathon build, Encode London 2026.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070B14",
